  << /K [ 6229 0 R ]
     /P 6237 0 R
     /S /P
     /Pg 6005 0 R
     /Type /StructElem
  >>
endobj

6231 0 obj
  << /ActualText (THE FINAL THOUGHT\n\nIs more technology really necessary\077)
     /K [ 113 ]
     /P 6232 0 R
     /Pg 6005 0 R
     /S /Span
     /Type /StructElem
  >>
